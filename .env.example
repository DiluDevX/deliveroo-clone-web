# Backend API Configuration
# URL of the Backend For Frontend (BFF) server
BFF_API_URL=http://localhost:3000

# BFF API Key for authentication
# Required for all API requests to the BFF
VITE_BFF_API_KEY=your-bff-api-key-here

# Firebase Configuration
# Get these values from your Firebase Console project settings
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Stripe Configuration
# Public/Publishable key for Stripe payments
# Get this from your Stripe Dashboard
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
